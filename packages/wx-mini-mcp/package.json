{
  "name": "@uni_toolkit/wx-mini-mcp",
  "version": "0.1.0",
  "description": "MCP server for WeChat Mini Program automation via WeChat DevTools (miniprogram-automator).",
  "type": "commonjs",
  "bin": {
    "wx-mini-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsdown --config-loader unrun",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --config-loader unrun --watch --sourcemap",
    "start": "node dist/index.js",
    "start:debug": "node --enable-source-maps dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector && pnpm run start"
  },
  "keywords": [
    "uni-app",
    "微信小程序",
    "miniprogram",
    "mcp",
    "miniprogram-automator"
  ],
  "author": "chouchouji <1305974212@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/uni-toolkit/uni-toolkit/tree/main/packages/wx-mini-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-toolkit/uni-toolkit.git",
    "directory": "packages/wx-mini-mcp"
  },
  "bugs": {
    "url": "https://github.com/uni-toolkit/uni-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@uni_toolkit/uniapp-miniprogram-devtool": "workspace:*",
    "miniprogram-automator": "^0.12.1",
    "ws": "^6.2.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
